#!/bin/sh
# Stop hook: once per session, remind Claude to harvest durable learnings.
# Never writes to memory itself (no surprise auto-writes).
set -u

ROOT="${CLAUDE_PROJECT_DIR:-.}"
FLAG="$ROOT/.claunchpad/.harvest-nudged"

# Already nudged this session -> allow the stop silently.
if [ -f "$FLAG" ]; then
  exit 0
fi

mkdir -p "$ROOT/.claunchpad" 2>/dev/null || true
: > "$FLAG" 2>/dev/null || true

if [ -f "$ROOT/.claunchpad/handoff.md" ]; then
  cat <<'JSON'
{"decision":"block","reason":"Before finishing: if this session produced a durable decision, a resolved failure, or a reusable technique, file it in MEMORY.md (or a memory/ fact file). Update an existing entry rather than adding a duplicate, and mark any fact this contradicts as superseded instead of deleting it. Then refresh .claunchpad/handoff.md: rewrite Now (goal, state, next step) and add one line to Recent sessions. If nothing is worth keeping, say so briefly and stop. This reminder fires once per session."}
JSON
else
  cat <<'JSON'
{"decision":"block","reason":"Before finishing: if this session produced a durable decision, a resolved failure, or a reusable technique, file it in MEMORY.md (or a memory/ fact file). Update an existing entry rather than adding a duplicate, and mark any fact this contradicts as superseded instead of deleting it. If nothing is worth keeping, say so briefly and stop. This reminder fires once per session."}
JSON
fi
exit 0
